# Variables de entorno de la API (solo referencia, valores de desarrollo).
# Nada carga este archivo automáticamente: no se usa python-dotenv.
# Exportá las variables en tu shell o configurá el entorno del proceso (ver README).
# Nunca versionar un .env con valores reales: este repo solo incluye placeholders.

APP_ENV=development
DATABASE_URL=sqlite:///./turnos.db
CLINIC_TIMEZONE=America/Argentina/Buenos_Aires

# Autenticación (C-03)
# JWT_SECRET: 32+ caracteres aleatorios (64+ si usás HS512). Obligatoria fuera de development/test.
JWT_SECRET=<cambiar-por-un-valor-largo-y-aleatorio-de-32-caracteres-o-mas>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Solo development: contraseña inicial de admin_demo. Definila en tu entorno, nunca acá.
SEED_ADMIN_PASSWORD=<definir-localmente>
